{
  "manifest_version": 2,
  "name": "Aviator Live Analyzer",
  "version": "1.0",
  "description": "Live statistical analyzer for Aviator results.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.betika.com/*"],
      "js": ["content.js"]
    }
  ],
  "browser_action": {
    "default_title": "Aviator Analyzer",
    "default_popup": "popup.html"
  }
}
